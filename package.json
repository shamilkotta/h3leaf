{
  "name": "h3leaf-monorepo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "publish:h3leaf": "pnpm --filter h3leaf publish"
  },
  "devDependencies": {
    "h3": "^2.0.1-rc.9",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.0"
}
